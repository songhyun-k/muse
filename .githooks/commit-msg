#!/bin/sh
set -eu
python3 - "$1" <<'PY'
from pathlib import Path
import subprocess
import sys
count = int(subprocess.check_output(['git', 'rev-list', '--count', '--ignore-missing', 'HEAD']))
prefix = f'C{count + 1:02} '
assert Path(sys.argv[1]).read_text().startswith(prefix), f'Commit subject must start with {prefix}'
PY
